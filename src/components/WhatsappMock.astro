---
// WhatsApp Dark Mode — Cores Oficiais e Proporções Reais
---
<div class="relative bg-[#0b141a] overflow-hidden w-full h-full flex flex-col font-sans">
  <!-- Header WhatsApp -->
  <div class="bg-[#202c33] px-4 pt-11 pb-3 flex items-center gap-3">
    <div class="relative flex-shrink-0">
      <img src="/icone-app.png" alt="AssisTech" class="w-10 h-10 rounded-full object-cover" />
      <div class="absolute bottom-0 right-0 w-3 h-3 bg-[#25D366] border-2 border-[#202c33] rounded-full"></div>
    </div>
    <div class="flex-1 min-w-0">
      <p class="text-[#e9edef] text-[15px] font-semibold leading-tight">AssisTech BOT</p>
      <p class="text-[#8696a0] text-[12px] mt-0.5">online</p>
    </div>
    <div class="flex gap-4 text-[#aebac1]">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4c-4.418 0-8 3.582-8 8s3.582 8 8 8 8-3.582 8-8-3.582-8-8-8zm0 14.5c-3.59 0-6.5-2.91-6.5-6.5s2.91-6.5 6.5-6.5 6.5 2.91 6.5 6.5-2.91 6.5-6.5 6.5zM12 7c-2.757 0-5 2.243-5 5s2.243 5 5 5 5-2.243 5-5-2.243-5-5-5z"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
    </div>
  </div>

  <!-- Messages -->
  <div class="px-4 py-4 space-y-4 bg-[#0b141a] flex-1 overflow-y-auto">
    <!-- Date divider -->
    <div class="flex justify-center my-2">
      <span class="bg-[#182229] text-[#8696a0] text-[11px] px-3 py-1 rounded-lg uppercase tracking-wide">Hoje</span>
    </div>

    <!-- Bot greeting bubble -->
    <div class="max-w-[85%]">
      <div class="bg-[#202c33] rounded-lg rounded-tl-none px-3 py-2 shadow-sm relative">
        <!-- Message Tail -->
        <div class="absolute top-0 -left-2 w-3 h-3 bg-[#202c33]" style="clip-path: polygon(100% 0, 100% 100%, 0 0);"></div>
        <p class="text-[#e9edef] text-[14px] leading-relaxed">
          Olá! Encontro a película certa em segundos. Suas 3 primeiras consultas são grátis. Qual modelo você procura?
        </p>
        <p class="text-[#8696a0] text-[10px] text-right mt-1">09:47</p>
      </div>
    </div>

    <!-- User message bubble -->
    <div class="max-w-[70%] ml-auto">
      <div class="bg-[#005c4b] rounded-lg rounded-tr-none px-3 py-2 shadow-sm relative">
        <!-- Message Tail -->
        <div class="absolute top-0 -right-2 w-3 h-3 bg-[#005c4b]" style="clip-path: polygon(0 0, 0 100%, 100% 0);"></div>
        <p class="text-[#e9edef] text-[14px]">ifone onze</p>
        <div class="flex items-center justify-end gap-1 mt-1">
          <p class="text-[#8696a0] text-[10px]">09:48</p>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#53bdeb"><path d="M0 12.116l2.016-2.012 5.477 5.497 14.491-14.512 2.016 2.012-16.507 16.524z"/></svg>
        </div>
      </div>
    </div>

    <!-- Bot response bubble -->
    <div class="max-w-[85%]">
      <div class="bg-[#202c33] rounded-lg rounded-tl-none px-3 py-2 shadow-sm relative border border-white/5">
        <!-- Message Tail -->
        <div class="absolute top-0 -left-2 w-3 h-3 bg-[#202c33]" style="clip-path: polygon(100% 0, 100% 100%, 0 0);"></div>
        <p class="text-[#e9edef] text-[14px] leading-relaxed">
          ✅ <span class="font-bold">Compatível:</span><br />
          iPhone 11 / iPhone XR<br /><br />
          💡 Profissionalize sua bancada com o AssisTech.
        </p>
        <p class="text-[#8696a0] text-[10px] text-right mt-1">09:48</p>
      </div>
    </div>
  </div>

  <!-- Input Area -->
  <div class="p-2 bg-[#202c33] flex items-center gap-2 pb-6">
    <div class="flex-shrink-0 text-[#aebac1]">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
    </div>
    <div class="flex-1 bg-[#2a3942] rounded-full h-10 px-4 flex items-center">
       <span class="text-[#8696a0] text-[15px]">Mensagem</span>
    </div>
    <div class="w-10 h-10 rounded-full bg-[#00a884] flex items-center justify-center text-white">
       <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M1.101 21.757L23.8 12.028 1.101 2.3l.011 7.912 13.623 1.816-13.623 1.817-.011 7.912z"/></svg>
    </div>
  </div>
</div>
